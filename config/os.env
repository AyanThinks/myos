# ==========================================================================
#  THE ONE PLACE TO RENAME YOUR OS
#  Everything (os-release, Plymouth, GDM, welcome wizard, ujust, image name,
#  workflows, ISO) reads these values. Edit, commit, push. Done.
# ==========================================================================
MYOS_NAME="MyOS"                 # Display name, any characters except double quotes
MYOS_ID="myos"                   # lowercase slug: used for image name, dirs, theme id
MYOS_TAGLINE="A Windows-style, glass-and-rounded gaming desktop built on Bazzite"
MYOS_URL="https://github.com/AyanThinks/myos"   # only used in os-release HOME_URL

# Default base (the CI matrix in .github/workflows/build.yml overrides this
# to also build an NVIDIA variant).
BASE_IMAGE="ghcr.io/ublue-os/bazzite-gnome"
BASE_TAG="stable"

# Rebuild the initramfs so the Plymouth boot splash is inside it (1 = yes).
REGENERATE_INITRAMFS=1
# 1 = fail the build if a GNOME extension cannot be fetched for this GNOME version.
STRICT_EXTENSIONS=0
